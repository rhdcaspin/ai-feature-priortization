# ── Jira credentials ──────────────────────────────────────────────────
# Used by: all scripts (via jira_auth.py)
JIRA_BASE_URL=https://redhat.atlassian.net
JIRA_EMAIL=your_email@redhat.com
JIRA_TOKEN=your_jira_cloud_api_token_here
# Alternative name (same value; ignored if JIRA_TOKEN is set):
# JIRA_API_TOKEN=your_jira_cloud_api_token_here

# ── Jira custom field overrides ───────────────────────────────────────
# Used by: jira_feature_validator.py, rox_target_version_labels_pm_validation.py,
#          rox_feature_export_notebooklm.py, rox_assignee_pm_report.py
# JIRA_PRODUCT_MANAGER_FIELD=customfield_10469
# JIRA_TARGET_VERSION_FIELD=customfield_10855
# JIRA_PRODUCT_MANAGER_JQL=Product Manager     # JQL name for PM field (rox_assignee_pm_report.py)

# ── RICE score fields ────────────────────────────────────────────────
# Used by: jira_feature_validator.py (CSV export columns)
# Set all four to fetch from Jira; leave unset for empty columns.
# JIRA_RICE_REACH_FIELD=customfield_xxxxx
# JIRA_RICE_IMPACT_FIELD=customfield_xxxxx
# JIRA_RICE_CONFIDENCE_FIELD=customfield_xxxxx
# JIRA_RICE_EFFORT_FIELD=customfield_xxxxx
# JIRA_RICE_SCORE_FIELD=customfield_xxxxx

# ── Jira Rank (LexoRank) ─────────────────────────────────────────────
# Used by: rox_rice_rank_sync.py, jira_feature_validator.py
# JIRA_RANK_FIELD=customfield_10019
# JIRA_RANK_MANUAL_LABEL=rice-rank-manual       # Label to lock rank from auto-sync
# JIRA_RANK_COHORT=target-version                # target-version | label | both
# JIRA_RANK_VIEW=asc                             # asc = JPD global plan column; desc = Rank DESC boards
# JIRA_RANK_TARGET_VERSION=5.0.0                 # run_daily_rank_sync.sh default cohort

# ── Google Sheets integration ────────────────────────────────────────
# Used by: jira_feature_validator.py (--update-sheet), rox_rice_rank_sync.py,
#          rox_assignee_pm_report.py (--update-sheet / --google-sheet-title)
# Requires: gcloud auth login --enable-gdrive-access
# GOOGLE_SHEET_ID=your_google_sheet_id_here
# GOOGLE_SHEET_NAME=Sheet1

# ── Red Hat Customer Portal API ──────────────────────────────────────
# Used by: rfe_export.py, rfe_rox_mismatch_report.py,
#          rox_feature_export_notebooklm.py, rhacs_cases_export.py (via rh_api.py)
# Get your offline token from: https://access.redhat.com/management/api
RH_OFFLINE_TOKEN=your_offline_token_here

# ── NotebookLM upload ────────────────────────────────────────────────
# Used by: notebooklm_upload.py (called from rox_feature_export_notebooklm.py,
#          rfe_export.py, rhacs_telemetry_export.py, rhacs_cases_export.py)
# Prefers `nlm` CLI (same auth as NLM MCP); falls back to notebooklm-py.
# NOTEBOOKLM_UPLOAD_BACKEND=auto                 # auto | nlm | py
# NOTEBOOKLM_NOTEBOOK_NAME=The Big Notebook for RHACS Product Management

# ── NotebookLM RICE scoring ─────────────────────────────────────────
# Used by: rox_target_version_labels_pm_validation.py (--notebooklm-rice)
# NOTEBOOKLM_RICE_QUERY_TIMEOUT=600              # seconds per batch
# NOTEBOOKLM_RICE_DESC_MAX=600                   # nlm: max chars of Jira description per feature
# NOTEBOOKLM_RICE_DESC_MAX_PY=1800               # notebooklm-py: default excerpt length
# NOTEBOOKLM_RICE_SUMMARY_MAX=500                # max chars of Jira summary per issue (0 = keys only)
# NOTEBOOKLM_RICE_INCLUDE_JIRA_CONTEXT=1         # embed Jira summary/description in RICE prompts

# ── Ollama (local LLM) ──────────────────────────────────────────────
# Used by: rox_feature_category_labels.py (AI pillar classification)
# OLLAMA_MODEL=llama3.2                           # required for category labeling
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TIMEOUT=600

# ── Snowflake ────────────────────────────────────────────────────────
# Used by: rhacs_telemetry_export.py
# SNOWFLAKE_ACCOUNT=your_snowflake_account
# SNOWFLAKE_USER=your_snowflake_username
# SNOWFLAKE_WAREHOUSE=your_warehouse
# SNOWFLAKE_ROLE=your_role
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
