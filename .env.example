# JIRA Configuration (Jira Cloud)
JIRA_BASE_URL=https://redhat.atlassian.net
# Required for *.atlassian.net: same Atlassian account as the API token (Basic auth).
JIRA_EMAIL=your_email@redhat.com
JIRA_TOKEN=your_jira_cloud_api_token_here
# Alternative name (same value; ignored if JIRA_TOKEN is set):
# JIRA_API_TOKEN=your_jira_cloud_api_token_here

# Optional: override Jira custom field ids (jira_feature_validator.py, rox_target_version_labels_pm_validation.py)
# JIRA_PRODUCT_MANAGER_FIELD=customfield_10469
# JIRA_PRODUCT_MANAGER_JQL=Product Manager   # JQL name for rox_assignee_pm_report.py (if different from default)
# JIRA_TARGET_VERSION_FIELD=customfield_10855
# RICE columns in jira_feature_validator.py CSV (set all four to fetch from Jira; leave unset for empty columns)
# JIRA_RICE_REACH_FIELD=customfield_xxxxx
# JIRA_RICE_IMPACT_FIELD=customfield_xxxxx
# JIRA_RICE_CONFIDENCE_FIELD=customfield_xxxxx
# JIRA_RICE_EFFORT_FIELD=customfield_xxxxx
# JIRA_RICE_SCORE_FIELD=customfield_xxxxx   # Jira custom field id for the RICE Score field (CSV exports)
# JIRA_RANK_FIELD=customfield_10019         # Rank (LexoRank) on Cloud; rox_rice_rank_sync.py
# JIRA_RANK_MANUAL_LABEL=rice-rank-manual   # Label to lock rank from auto-sync (rox_rice_rank_sync.py)
# JIRA_RANK_COHORT=target-version             # target-version | label | both (rox_rice_rank_sync.py)
# JIRA_RANK_VIEW=asc                          # asc = JPD global plan # column; desc = Rank DESC boards

# Optional: NotebookLM notebook title for rox_target_version_labels_pm_validation.py --notebooklm-rice
# NOTEBOOKLM_NOTEBOOK_NAME=The Big Notebook for RHACS Product Management

# NotebookLM MCP (NLM) in Cursor: install notebooklm-mcp-cli, then `nlm login`
# Project MCP config: .cursor/mcp.json (server name: NLM). If Cursor cannot find the binary,
# set "command" in mcp.json to the absolute path from: which notebooklm-mcp
#
# Python export scripts use notebooklm_upload.py: prefers `nlm` (same auth as NLM MCP), else notebooklm-py.
# NOTEBOOKLM_UPLOAD_BACKEND=auto   # auto | nlm | py
# NOTEBOOKLM_RICE_QUERY_TIMEOUT=600   # seconds per batch for rox_target_version_labels_pm_validation.py --notebooklm-rice (nlm path)
# NOTEBOOKLM_RICE_DESC_MAX=600        # nlm: max chars of Jira description per feature in RICE prompt (smaller avoids Google INVALID_ARGUMENT)
# NOTEBOOKLM_RICE_DESC_MAX_PY=1800    # notebooklm-py path default excerpt length
# NOTEBOOKLM_RICE_SUMMARY_MAX=500     # default RICE prompt: each line is key + Jira summary (0 = keys only; needs sources to know each issue)
# NOTEBOOKLM_RICE_INCLUDE_JIRA_CONTEXT=1   # embed Jira summary/description in RICE prompts (full context; disables keys-only mode)

# AI pillar labels (rox_feature_category_labels.py)
# Auto backend: Ollama if OLLAMA_MODEL is set, else OpenAI if OPENAI_API_KEY, else Anthropic.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TIMEOUT=600
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Sheets integration (jira_feature_validator.py --update-sheet)
# Requires: gcloud auth login --enable-gdrive-access
# GOOGLE_SHEET_ID=your_google_sheet_id_here
# GOOGLE_SHEET_NAME=Your tab name

# Red Hat Customer Portal API (for SFDC account name lookup)
# Get your offline token from: https://access.redhat.com/management/api
RH_OFFLINE_TOKEN=your_offline_token_here

# Snowflake Configuration (for rhacs_telemetry_export.py)
# Required for daily automated RHACS telemetry exports
# SNOWFLAKE_ACCOUNT=your_snowflake_account
# SNOWFLAKE_USER=your_snowflake_username
# SNOWFLAKE_WAREHOUSE=your_warehouse
# SNOWFLAKE_ROLE=your_role
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
