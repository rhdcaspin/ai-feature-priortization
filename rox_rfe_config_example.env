# ROX RFE Fetcher Configuration Example
# Copy this file to your preferred location and source it before running the script

# Red Hat Jira Configuration
export JIRA_URL=https://issues.redhat.com
export JIRA_TOKEN=your_api_token_here

# Get your token from:
# https://issues.redhat.com/secure/ViewProfile.jspa?selectedTab=com.atlassian.pats.pats-plugin:jira-user-personal-access-tokens

# Optional: Default CIPOE project to filter by
# export CIPOE_PROJECT=CIPOE-123

# Usage:
# source rox_rfe_config_example.env
# python3 rox_rfe_fetcher.py --cipoe-project $CIPOE_PROJECT
